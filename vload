#!/usr/bin/env bash
###############################################################################
# Subdomain Recon — rewritten, fast & robust (Kali / WSL2)
#
# Pipeline:
#   enumerate (parallel sources) -> clean/dedupe -> resolve (dnsx, JSON)
#   -> enrich unique IPs (ip-api batch) -> ports (naabu) -> PTR + ping (per IP)
#   -> HTTP probe (httpx) -> assemble one fully-populated row per subdomain
#
# Design notes:
#   * All parsing is JSON via jq — no brittle awk/regex on tool output.
#   * Every expensive lookup (org/isp, ports, ping, PTR) is done ONCE per
#     unique IP, not once per subdomain — huge speedup on CDN-heavy targets.
#   * Real ProjectDiscovery Go binaries are forced onto PATH (a python
#     "httpx" wrapper otherwise shadows the recon httpx).
#   * No hard-coded secrets. Telegram is opt-in via env vars.
###############################################################################

set -o pipefail
shopt -s lastpipe

# ── Make sure the Go recon binaries win over any python shim ─────────────────
export PATH="$HOME/go/bin:/usr/local/go/bin:$PATH"

# ── Colors ───────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
    BLUE=$'\033[0;34m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
    RED=; GREEN=; YELLOW=; BLUE=; CYAN=; BOLD=; NC=
fi
info(){ echo -e "${BLUE}[*]${NC} $*"; }
ok(){   echo -e "${GREEN}[+]${NC} $*"; }
warn(){ echo -e "${YELLOW}[!]${NC} $*"; }
err(){  echo -e "${RED}[-]${NC} $*" >&2; }
step(){ echo -e "\n${CYAN}${BOLD}══ $* ══${NC}"; }

# ── Tunables (override via environment) ──────────────────────────────────────
DNS_THREADS="${DNS_THREADS:-600}"        # dnsx concurrency
DNS_RETRY="${DNS_RETRY:-2}"
DNS_TIMEOUT="${DNS_TIMEOUT:-3}"          # per-query timeout (s)
RESOLVE2_BUDGET="${RESOLVE2_BUDGET:-180}" # time cap (s) for patient 2nd resolve pass
HTTP_THREADS="${HTTP_THREADS:-400}"      # httpx concurrency
HTTP_TIMEOUT="${HTTP_TIMEOUT:-5}"
NAABU_RATE="${NAABU_RATE:-5000}"         # naabu packets/sec
PORTS_TO_SCAN="${PORTS_TO_SCAN:-80,443,8080,8443,8000,8888}"
ENUM_TIMEOUT="${ENUM_TIMEOUT:-180}"      # hard cap per enumeration source (s)
MAX_PARALLEL_DOMAINS="${MAX_PARALLEL_DOMAINS:-20}" # domains enumerated at once (rest queue)
CURL_TIMEOUT="${CURL_TIMEOUT:-25}"
# Reverse-DNS (PTR) expansion tuning — the heaviest stage on big targets.
PTR_MAX_NETS="${PTR_MAX_NETS:-4000}"     # max /24 subnets to sweep (densest first)
PTR_THREADS="${PTR_THREADS:-2000}"       # PTR is lightweight → high concurrency
PTR_BUDGET="${PTR_BUDGET:-600}"          # hard time budget for the sweep (partial OK)
# ASN netblock expansion (see asn_netblocks()) — sweeps the target's FULL
# announced IP space via public BGP/WHOIS data, not just subnets we stumbled
# into. Set ASN_SWEEP=false to fall back to discovered-IP-only sweeping (faster).
ASN_SWEEP="${ASN_SWEEP:-true}"
ASN_MAX_NETS="${ASN_MAX_NETS:-5000}"     # cap on /24s pulled from the target's ASN(s)
PLACEHOLDER="-"                          # shown when a value is genuinely absent

# ── Telegram (opt-in): export TELEGRAM_TOKEN and TELEGRAM_CHAT_ID to enable ──
TELEGRAM_TOKEN="${TELEGRAM_TOKEN:-}"
TELEGRAM_CHAT_ID="${TELEGRAM_CHAT_ID:-}"

# ── Workspace ────────────────────────────────────────────────────────────────
OUTBASE="${OUTBASE:-$HOME/recon}"
WORKDIR=""            # set in setup_workspace
FINAL=""              # final pipe-delimited results file
TERMINATED=false

trap 'terminate' INT TERM
terminate(){ TERMINATED=true; echo; err "Interrupted — partial results (if any) are in: ${WORKDIR:-<none>}"; exit 130; }

###############################################################################
# Setup
###############################################################################
check_tools(){
    local required=(subfinder assetfinder amass dnsx httpx naabu jq curl fping sort awk sed grep)
    local missing=()
    for t in "${required[@]}"; do command -v "$t" &>/dev/null || missing+=("$t"); done

    # netcat (either flavour) is needed for the Team Cymru bulk IP→ASN lookup.
    if command -v nc &>/dev/null; then NC_BIN=nc
    elif command -v netcat &>/dev/null; then NC_BIN=netcat
    else missing+=("nc/netcat"); fi

    # httpx must be the ProjectDiscovery Go binary, not the python package.
    if command -v httpx &>/dev/null && ! httpx -version &>/dev/null; then
        err "The 'httpx' on PATH is not the ProjectDiscovery tool."
        err "Install it:  go install github.com/projectdiscovery/httpx/cmd/httpx@latest"
        missing+=("httpx(go)")
    fi

    # Try to auto-install any missing recon binaries straight from the
    # vload-domain release (exact pinned versions), then re-check.
    if [ "${#missing[@]}" -gt 0 ]; then
        warn "Missing tools: ${missing[*]} — attempting auto-install from vload-domain release..."
        autoinstall_tools "${missing[@]}"
        missing=()
        for t in "${required[@]}"; do command -v "$t" &>/dev/null || missing+=("$t"); done
        if command -v nc &>/dev/null; then NC_BIN=nc
        elif command -v netcat &>/dev/null; then NC_BIN=netcat
        else missing+=("nc/netcat"); fi
    fi

    if [ "${#missing[@]}" -gt 0 ]; then
        err "Still missing: ${missing[*]}"
        echo "   Install everything with one command:"
        echo "     curl -fsSL https://raw.githubusercontent.com/alaaabd90/vload-domain/main/install.sh | sudo bash"
        exit 1
    fi
    command -v findomain &>/dev/null && HAVE_FINDOMAIN=true || HAVE_FINDOMAIN=false
    ok "All required tools present${HAVE_FINDOMAIN:+ (findomain: $HAVE_FINDOMAIN)}"
}

# Pull missing recon binaries from the vload-domain release (gzip'd assets).
# apt tools (jq/curl/fping/whois/nc…) are handled by install.sh, not here.
autoinstall_tools(){
    local repo_dl="https://github.com/alaaabd90/vload-domain/releases/latest/download"
    local bin="/usr/local/bin" sudo="" t tmp
    [ "$(id -u)" -ne 0 ] && sudo="sudo"
    for t in "$@"; do
        case "$t" in
            subfinder|dnsx|httpx|naabu|amass|assetfinder|findomain) ;;
            *) continue ;;   # system tools -> leave to install.sh / apt
        esac
        tmp=$(mktemp)
        if curl -fsSL "${repo_dl}/${t}.gz" -o "${tmp}.gz" 2>/dev/null \
           && gunzip -f "${tmp}.gz" 2>/dev/null; then
            $sudo install -m 0755 "$tmp" "${bin}/${t}" 2>/dev/null && ok "  installed $t from repo"
        fi
        rm -f "$tmp" "${tmp}.gz" 2>/dev/null || true
    done
}

setup_workspace(){
    local label="$1"
    local ts; ts=$(date +%Y%m%d_%H%M%S)
    WORKDIR="$OUTBASE/${label}_${ts}"
    mkdir -p "$WORKDIR" || { err "Cannot create $WORKDIR"; exit 1; }
    FINAL="$WORKDIR/subdomains.txt"
    info "Workspace: ${BOLD}$WORKDIR${NC}"
}

###############################################################################
# Fetch Common Crawl's current index ID(s) ONCE for the whole run (not once
# per domain) — the two most recent crawls, for broader time coverage.
# Left empty (CC_INDEXES="") if unreachable; every call site checks for that
# and simply contributes nothing, same as any other source going dark.
###############################################################################
CC_INDEXES=""
fetch_cc_index(){
    local resp; resp=$(curl -sf --max-time 15 "https://index.commoncrawl.org/collinfo.json" 2>/dev/null)
    [ -z "$resp" ] && { warn "Common Crawl index unreachable — that source will be skipped"; return 0; }
    CC_INDEXES=$(echo "$resp" | jq -r '.[0:2][].id' 2>/dev/null | tr '\n' ' ')
}

###############################################################################
# 1. Enumeration — every source runs in parallel, each with a hard timeout
###############################################################################
run_enumeration(){
    local domain="$1"
    # Per-domain subdir so multiple domains can enumerate in parallel without
    # clobbering each other's source files.
    local d="$WORKDIR/enum/$(printf '%s' "$domain" | tr -c 'a-zA-Z0-9.-' '_')"
    mkdir -p "$d"
    step "Enumerating subdomains for $domain"

    ( timeout -k 15 "$ENUM_TIMEOUT" subfinder -d "$domain" -silent -all \
        -o "$d/subfinder.txt" &>/dev/null ) &
    ( timeout -k 15 "$ENUM_TIMEOUT" assetfinder --subs-only "$domain" \
        > "$d/assetfinder.txt" 2>/dev/null ) &
    # -dir isolates amass's graph database per invocation. Without it, every
    # concurrent amass process shares ~/.config/amass/amass.sqlite: they race
    # on the same local DB, which both drops results for some domains (lock
    # contention) and bleeds OTHER domains' records into this domain's output.
    # -exclude SubdomainCenter: that source injects generated/mutated candidate
    # names (see the subdomain.center removal above) — amass has its own
    # integration with it, so excluding it here too keeps that noise fully
    # out, not just from our own direct call. The rest (HackerTarget,
    # ThreatMiner, SiteDossier, Riddler) are confirmed dead/quota-exhausted;
    # Wayback/URLScan are already covered by our own direct calls below.
    # -r <static resolvers>: WITHOUT this, amass tries to auto-build its own
    # resolver pool at startup, and running many instances at once makes that
    # bootstrap step fail outright for most of them ("the system was unable
    # to build the pool of untrusted resolvers" — confirmed by direct
    # reproduction: only 1-5 of 15 concurrent amass runs produced ANY output
    # without this; giving it a fixed list made all 15/15 succeed).
    ( timeout -k 15 "$ENUM_TIMEOUT" amass enum -passive -d "$domain" \
        -dir "$d/amass_dir" \
        -exclude HackerTarget,ThreatMiner,SiteDossier,Riddler,Wayback,URLScan,SubdomainCenter \
        -r 8.8.8.8 -r 1.1.1.1 -r 9.9.9.9 -r 208.67.222.222 -r 94.140.14.14 -r 77.88.8.8 \
        -o "$d/amass.txt" &>/dev/null ) &

    # findomain tries ~8 sources in sequence internally; several are the same
    # dead ones (ThreatCrowd unreachable, AnubisDB Cloudflare-blocked,
    # ThreatMiner 522) that silently ate up to 120s+ per domain waiting on
    # them — confirmed via direct timing: excluding them cut findomain from
    # 88s (twitter.com) to 21s and from a 120s+ timeout-kill (whatsapp.net) to
    # under 1s, with IDENTICAL result counts both times. urlscan/archiveorg
    # are also excluded since we already query those sources directly below.
    $HAVE_FINDOMAIN && ( timeout -k 15 "$ENUM_TIMEOUT" findomain -t "$domain" -q \
        --exclude-sources threatcrowd anubis threatminer bufferover_free bufferover_paid archiveorg urlscan certspotter \
        > "$d/findomain.txt" 2>/dev/null ) &

    # crt.sh — Certificate Transparency. Use the plain ?q=<domain> query: the
    # %25. wildcard form returns 502 constantly, while the plain query returns
    # all SAN entries (incl. subdomains). name_value can hold newline-separated
    # names. crt.sh's backend is frequently overloaded (502s, or just hangs) —
    # it's our only CT source now, so retry patiently with backoff.
    ( for wait in 3 6 10 15; do
        timeout -k 15 "$ENUM_TIMEOUT" curl -sf --max-time 40 \
            "https://crt.sh/?q=${domain}&output=json" 2>/dev/null \
            | jq -r '.[].name_value' 2>/dev/null \
            | tr ',' '\n' | sed 's/\\n/\n/g' > "$d/crtsh.txt"
        [ -s "$d/crtsh.txt" ] && break; sleep "$wait"
      done ) &

    ( timeout -k 15 "$ENUM_TIMEOUT" curl -sf --max-time "$CURL_TIMEOUT" \
        "https://rapiddns.io/subdomain/${domain}?full=1&down=1" 2>/dev/null \
        | grep -oE '[a-zA-Z0-9._-]+\.'"${domain//./\\.}" > "$d/rapiddns.txt" ) &

    # AlienVault OTX — url_list (NOT passive_dns: that endpoint now demands an
    # API key and always 429s anonymously. url_list is still open/keyless and
    # carries the same hostnames, just paginated — walk a few pages passively.)
    ( : > "$d/otx.txt"
      page=1
      while [ "$page" -le 5 ]; do
          resp=$(timeout -k 15 "$ENUM_TIMEOUT" curl -sf --max-time "$CURL_TIMEOUT" \
              "https://otx.alienvault.com/api/v1/indicators/domain/${domain}/url_list?limit=100&page=${page}" 2>/dev/null)
          [ -z "$resp" ] && break
          echo "$resp" | jq -r '.url_list[]?.hostname' 2>/dev/null >> "$d/otx.txt"
          [ "$(echo "$resp" | jq -r '.has_next' 2>/dev/null)" = "true" ] || break
          page=$((page + 1))
      done ) &

    # Wayback Machine (web.archive.org) — historical hostnames
    ( timeout -k 15 "$ENUM_TIMEOUT" curl -sf --max-time "$CURL_TIMEOUT" \
        "http://web.archive.org/cdx/search/cdx?url=*.${domain}&output=text&fl=original&collapse=urlkey&limit=50000" 2>/dev/null \
        | sed -E 's#^https?://##; s#/.*##; s#:.*##' \
        | grep -iE "\.${domain//./\\.}$" > "$d/wayback.txt" ) &

    # urlscan.io — hostnames from indexed page scans
    ( timeout -k 15 "$ENUM_TIMEOUT" curl -sf --max-time "$CURL_TIMEOUT" \
        "https://urlscan.io/api/v1/search/?q=domain:${domain}&size=10000" 2>/dev/null \
        | jq -r '.results[]?.page.domain, .results[]?.task.domain' 2>/dev/null \
        | grep -iE "\.${domain//./\\.}$" > "$d/urlscan.txt" ) &

    # Common Crawl — a separate large-scale web index with its own crawler,
    # independent of Wayback/archive.org; can surface hosts neither that nor
    # any CT-log-based source ever saw. $CC_INDEXES is fetched once globally
    # (see fetch_cc_index) and left empty if Common Crawl is unreachable,
    # in which case this contributes nothing rather than wasting time.
    if [ -n "$CC_INDEXES" ]; then
        ( : > "$d/commoncrawl.txt"
          for idx in $CC_INDEXES; do
              timeout -k 15 "$ENUM_TIMEOUT" curl -sf --max-time "$CURL_TIMEOUT" \
                  "https://index.commoncrawl.org/${idx}-index?url=*.${domain}&output=json&limit=20000" 2>/dev/null \
                  | jq -r '.url' 2>/dev/null \
                  | sed -E 's#^https?://##; s#/.*##; s#:.*##' \
                  | grep -iE "\.${domain//./\\.}$" >> "$d/commoncrawl.txt"
          done
          sort -u "$d/commoncrawl.txt" -o "$d/commoncrawl.txt" ) &
    fi

    wait   # all sources finish (each is bounded by ENUM_TIMEOUT)

    local f
    for f in "$d"/*.txt; do
        [ -f "$f" ] || continue
        ok "  [$domain] $(basename "$f" .txt) → $(count "$f")"
    done
    # NOTE: merging into raw_subs.txt is done by the caller after ALL domains
    # finish (so domains can run in parallel safely).
}

###############################################################################
# 2. Clean & dedupe — lowercase, keep only valid hostnames under the targets
###############################################################################
clean_subs(){
    step "Cleaning & de-duplicating"
    # lowercase, strip wildcards/spaces, keep syntactically valid FQDNs
    tr '[:upper:]' '[:lower:]' < "$WORKDIR/raw_subs.txt" \
        | sed 's/^\*\.//; s/[[:space:]]//g; s/\.$//' \
        | grep -E '^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$' \
        | sort -u > "$WORKDIR/unique_subs.txt"

    # Keep only names that actually end in one of the target domains.
    : > "$WORKDIR/scope.txt"
    local dom
    for dom in "${DOMAINS[@]}"; do grep -E "(^|\.)${dom//./\\.}$" "$WORKDIR/unique_subs.txt"; done \
        | sort -u > "$WORKDIR/subs.txt"
    rm -f "$WORKDIR/scope.txt"

    local n; n=$(count "$WORKDIR/subs.txt")
    ok "$n valid unique subdomains"
    [ "$n" -eq 0 ] && { err "No subdomains found — aborting"; exit 1; }
}

###############################################################################
# 3. Resolve with dnsx (single robust pass; it follows CNAMEs internally)
###############################################################################
resolve(){
    step "Resolving DNS (dnsx, ${DNS_THREADS} threads)"
    build_resolvers

    # ── Pass 1: fast bulk resolve ────────────────────────────────────────────
    dnsx -l "$WORKDIR/subs.txt" -r "$WORKDIR/resolvers.txt" \
         -t "$DNS_THREADS" -retry "$DNS_RETRY" -timeout "$DNS_TIMEOUT" \
         -a -cname -json -silent -nc 2>/dev/null > "$WORKDIR/dnsx.json"
    jq -r 'select(.a!=null) | .host as $h | .a[0] | "\($h)\t\(.)"' \
        "$WORKDIR/dnsx.json" 2>/dev/null | sort -u > "$WORKDIR/resolved.tsv"

    local total p1; total=$(count "$WORKDIR/subs.txt"); p1=$(count "$WORKDIR/resolved.tsv")

    # ── Pass 2: patient retry of ONLY the leftovers ──────────────────────────
    # Catches transient failures and slow CNAME chains that one fast pass misses.
    # Runs on the small unresolved subset with more retries + longer timeout,
    # time-budgeted so it can never blow up at scale.
    comm -23 <(sort -u "$WORKDIR/subs.txt") \
             <(cut -f1 "$WORKDIR/resolved.tsv" | sort -u) > "$WORKDIR/_unresolved.tmp"
    local nun; nun=$(count "$WORKDIR/_unresolved.tmp")
    if [ "$nun" -gt 0 ]; then
        info "Pass 2: retrying $nun unresolved names (patient, ${RESOLVE2_BUDGET}s budget)..."
        timeout -k 10 "$RESOLVE2_BUDGET" dnsx -l "$WORKDIR/_unresolved.tmp" \
             -r "$WORKDIR/resolvers.txt" -t "$DNS_THREADS" -retry 4 -timeout 6 \
             -a -cname -json -silent -nc 2>/dev/null > "$WORKDIR/dnsx2.json" || true
        local recovered
        recovered=$(jq -r 'select(.a!=null) | .host as $h | .a[0] | "\($h)\t\(.)"' \
            "$WORKDIR/dnsx2.json" 2>/dev/null | sort -u | tee -a "$WORKDIR/resolved.tsv" | wc -l)
        sort -u "$WORKDIR/resolved.tsv" -o "$WORKDIR/resolved.tsv"
        ok "Pass 2 recovered $recovered additional host(s)"
        rm -f "$WORKDIR/dnsx2.json"
    fi
    rm -f "$WORKDIR/_unresolved.tmp"

    cut -f2 "$WORKDIR/resolved.tsv" | sort -u > "$WORKDIR/ips.txt"
    local rs ips; rs=$(count "$WORKDIR/resolved.tsv"); ips=$(count "$WORKDIR/ips.txt")
    ok "$rs/$total subdomains resolved → $ips unique IPs"
    [ "$rs" -eq 0 ] && { err "Nothing resolved — aborting"; exit 1; }
}

build_resolvers(){
    # Trusted, high-capacity public resolvers — always kept, never dropped.
    cat > "$WORKDIR/_trusted_res.txt" <<'EOF'
8.8.8.8
8.8.4.4
1.1.1.1
1.0.0.1
9.9.9.9
149.112.112.112
208.67.222.222
208.67.220.220
94.140.14.14
94.140.15.15
76.76.2.0
76.76.10.0
77.88.8.8
77.88.8.1
84.200.69.80
84.200.70.40
EOF
    cp "$WORKDIR/_trusted_res.txt" "$WORKDIR/_cand_res.txt"
    local extra
    extra=$(curl -sf --max-time 8 \
        "https://raw.githubusercontent.com/trickest/resolvers/main/resolvers.txt" 2>/dev/null | head -600)
    [ -n "$extra" ] && echo "$extra" >> "$WORKDIR/_cand_res.txt"
    sort -u "$WORKDIR/_cand_res.txt" -o "$WORKDIR/_cand_res.txt"

    # ── Validate resolvers (CRITICAL for correctness) ────────────────────────
    # Flaky/poisoned public resolvers return NOERROR-with-no-answer and silently
    # drop valid CNAME-chained hosts (e.g. investor.fb.com → q4web.com → CF).
    # Keep only resolvers that correctly answer a stable canary. ~2-3s, parallel.
    info "Validating $(count "$WORKDIR/_cand_res.txt") resolvers..."
    < "$WORKDIR/_cand_res.txt" xargs -P 80 -I{} bash -c '
        a=$(dig +short +time=1 +tries=1 @{} one.one.one.one A 2>/dev/null \
            | grep -E "^1\.(1\.1\.1|0\.0\.1)$" | head -1)
        [ -n "$a" ] && echo {}
    ' 2>/dev/null | sort -u > "$WORKDIR/resolvers.txt"
    # Always include the trusted core, and fall back to it if validation failed.
    cat "$WORKDIR/_trusted_res.txt" >> "$WORKDIR/resolvers.txt"
    sort -u "$WORKDIR/resolvers.txt" -o "$WORKDIR/resolvers.txt"
    local n; n=$(count "$WORKDIR/resolvers.txt")
    if [ "$n" -lt 10 ]; then
        warn "resolver validation yielded only $n — using full candidate list"
        cp "$WORKDIR/_cand_res.txt" "$WORKDIR/resolvers.txt"; n=$(count "$WORKDIR/resolvers.txt")
    fi
    ok "Using $n validated resolvers"
    rm -f "$WORKDIR/_cand_res.txt" "$WORKDIR/_trusted_res.txt"
}

###############################################################################
# 3a2. ASN netblock discovery — a target's real edge-node count is bounded by
#     its announced IP space, not by how many of its IPs a handful of passive
#     sources happened to mention. Find the target's own ASN(s) from IPs
#     already resolved (Team Cymru bulk — fast, no rate limit), then pull
#     ALL of that ASN's publicly-announced IPv4 prefixes from the RADB/IRR
#     routing registry — public BGP/network-ownership data, the same kind
#     every ISP on the internet publishes, not a wordlist of guessed names —
#     and feed those into the PTR sweep too, not just subnets we stumbled
#     into. Confirmed this closes a real gap: sweeping Facebook's full ASN
#     recovered thousands of genuine edge hostnames invisible to every
#     passive source and to a discovered-IP-only sweep.
###############################################################################
asn_netblocks(){
    [ "$ASN_SWEEP" = "false" ] && return 0
    step "ASN netblock discovery — fetching target org(s)' full announced IP space"

    { printf 'begin\nverbose\n'; cat "$WORKDIR/ips.txt"; printf 'end\n'; } \
        | timeout -k 10 60 "$NC_BIN" whois.cymru.com 43 2>/dev/null \
        | awk -F'|' '
            function trim(s){ gsub(/^[ \t]+|[ \t]+$/,"",s); return s }
            /Bulk mode|Error:|^[[:space:]]*$/ { next }
            NF>=7 { asn=trim($1); org=trim($7); if(asn!="" && asn!="NA") print asn"\t"org }
          ' | sort | uniq -c | sort -rn > "$WORKDIR/_asn_counts.tmp"

    local total; total=$(count "$WORKDIR/ips.txt")
    if [ "$total" -eq 0 ]; then rm -f "$WORKDIR/_asn_counts.tmp"; return 0; fi
    # "Significant" = this ASN's organization name textually matches one of
    # the target domains themselves (e.g. an ASN named "FACEBOOK" when
    # facebook.com is a target). This is far more reliable than an IP-count
    # threshold: a run mixing several companies' domains can have random
    # residential/mobile ISPs (stale DNS records pointing at reassigned
    # consumer IPs — see the dangling-record analysis this session) rack up
    # counts just as large as a legitimately smaller target's own real share,
    # so counting alone can't tell them apart. Matching the target's own
    # brand name in the ASN's registered org name can. Cloud/CDN providers
    # are still excluded even on a brand match (unlikely, but cheap safety).
    local brandlist; brandlist=$(printf '%s\n' "${DOMAINS[@]}" \
        | sed -E 's/\..*$//' | awk 'length($0)>=4' | tr '[:upper:]' '[:lower:]' | sort -u | paste -sd'|')
    if [ -z "$brandlist" ]; then
        ok "No usable brand keyword from target domains — skipping netblock expansion"
        rm -f "$WORKDIR/_asn_counts.tmp"; return 0
    fi
    awk -F'\t' -v brands="$brandlist" '
        {
            n = split($1, a, " "); cnt = a[1]; asn = a[n]; org = tolower($2)
            if (cnt+0 >= 3 && org ~ brands &&
                org !~ /amazon|aws|google|microsoft|azure|cloudflare|fastly|akamai|salesforce|digitalocean|linode|ovh|alibaba|oracle|hetzner|vultr/)
                print asn
        }' "$WORKDIR/_asn_counts.tmp" > "$WORKDIR/_sig_asns.tmp"
    local nasn; nasn=$(count "$WORKDIR/_sig_asns.tmp")
    rm -f "$WORKDIR/_asn_counts.tmp"
    if [ "$nasn" -eq 0 ]; then
        ok "No dominant ASN found for this target — skipping netblock expansion"
        rm -f "$WORKDIR/_sig_asns.tmp"; return 0
    fi
    info "Target ASN(s): $(tr '\n' ' ' < "$WORKDIR/_sig_asns.tmp")"

    : > "$WORKDIR/asn_prefixes.tmp"
    while read -r asn; do
        [ -z "$asn" ] && continue
        timeout -k 5 25 whois -h whois.radb.net -- "-i origin AS${asn}" 2>/dev/null \
            | awk '/^route:/{print $2}' >> "$WORKDIR/asn_prefixes.tmp"
    done < "$WORKDIR/_sig_asns.tmp"
    sort -u "$WORKDIR/asn_prefixes.tmp" -o "$WORKDIR/asn_prefixes.tmp"
    rm -f "$WORKDIR/_sig_asns.tmp"

    local npfx; npfx=$(count "$WORKDIR/asn_prefixes.tmp")
    if [ "$npfx" -eq 0 ]; then
        ok "No announced prefixes found"; rm -f "$WORKDIR/asn_prefixes.tmp"; return 0
    fi

    # Expand every prefix to its /24s. Skip anything broader than /16 — those
    # are typically legacy/umbrella allocations, mostly unused address space,
    # not actively-serving infrastructure, and would blow the sweep budget.
    # Smaller/more specific prefixes tend to be denser with real services, so
    # they're swept first if the cap is reached.
    awk -F'/' '{ print $0, (32-$2) }' "$WORKDIR/asn_prefixes.tmp" \
        | awk '$2<=16' \
        | sort -k2,2n \
        | awk -F'[ /.]' '
            function ip2int(a,b,c,d){ return a*16777216 + b*65536 + c*256 + d }
            function dotted24(n,   a,b,c){
                a=int(n/16777216); n=n%16777216
                b=int(n/65536); n=n%65536
                c=int(n/256)
                return a"."b"."c".0/24"
            }
            { start=ip2int($1,$2,$3,$4); p=$5
              nets=2^(24-p); if(nets<1) nets=1
              for(i=0;i<nets;i++) print dotted24(start+i*256)
            }' > "$WORKDIR/asn_nets_all.tmp"
    sort -u "$WORKDIR/asn_nets_all.tmp" -o "$WORKDIR/asn_nets_all.tmp"
    rm -f "$WORKDIR/asn_prefixes.tmp"

    local nexp; nexp=$(count "$WORKDIR/asn_nets_all.tmp")
    head -n "$ASN_MAX_NETS" "$WORKDIR/asn_nets_all.tmp" > "$WORKDIR/asn_nets.tmp"
    rm -f "$WORKDIR/asn_nets_all.tmp"
    ok "$nexp /24 subnet(s) across the target's announced IP space (capped to ${ASN_MAX_NETS} for the sweep)"
}

###############################################################################
# 3b. Reverse-DNS expansion — PTR-sweep the /24 subnets of resolved IPs, PLUS
#     the target's full ASN-announced netblocks from asn_netblocks() above.
#     The target owns this IP space; its PTR records reveal many hostnames no
#     passive source lists (edge-*, cloud-*, dohproxy-*, …). Not a wordlist —
#     it reads reverse DNS of subnets we know (or can prove via public BGP
#     records) are in play.
###############################################################################
reverse_dns_expand(){
    step "Reverse-DNS expansion — PTR sweep of discovered + ASN-wide /24 subnets (no wordlist)"
    # Order /24s by how many resolved IPs they contain (densest first) — these
    # are proven-relevant, so they always go first — then fill any remaining
    # budget with the target's other ASN-announced /24s from asn_netblocks().
    awk -F. 'NF==4 && $1>=1 && $1<=255 {c[$1"."$2"."$3]++}
             END{for(n in c) print c[n], n".0/24"}' "$WORKDIR/ips.txt" \
        | sort -rn | awk '{print $2}' > "$WORKDIR/_discovered_nets.tmp"
    if [ -s "$WORKDIR/asn_nets.tmp" ]; then
        cat "$WORKDIR/_discovered_nets.tmp" "$WORKDIR/asn_nets.tmp" | awk '!seen[$0]++' \
            | head -n "$PTR_MAX_NETS" > "$WORKDIR/cidrs.tmp"
    else
        head -n "$PTR_MAX_NETS" "$WORKDIR/_discovered_nets.tmp" > "$WORKDIR/cidrs.tmp"
    fi
    rm -f "$WORKDIR/_discovered_nets.tmp" "$WORKDIR/asn_nets.tmp"
    local nnets; nnets=$(count "$WORKDIR/cidrs.tmp")
    [ "$nnets" -eq 0 ] && { ok "No subnets to sweep"; return 0; }
    info "Sweeping $nnets /24 subnet(s), ${PTR_THREADS} threads, ${PTR_BUDGET}s budget..."
    # Record which /24s we sweep, so ptr_and_ping treats every IP in them as
    # covered (even IPs with no PTR record) and never re-queries them.
    sed 's#\.0/24$##' "$WORKDIR/cidrs.tmp" | sort -u > "$WORKDIR/swept_nets.txt"

    # High concurrency + 1 retry + short timeout; wrapped in a hard time budget.
    # JSON output captures BOTH the hostnames (for discovering new subdomains)
    # AND the ip→PTR map, which ptr_and_ping reuses so it never redoes reverse
    # DNS on these same IPs (eliminates a whole redundant PTR pass).
    timeout -k 10 "$PTR_BUDGET" dnsx -l "$WORKDIR/cidrs.tmp" -ptr -json -silent -nc \
         -t "$PTR_THREADS" -retry 1 -r "$WORKDIR/resolvers.txt" 2>/dev/null \
        > "$WORKDIR/ptr_sweep.json"

    # ip<TAB>ptr — kept for reuse (ptr_sweep.tsv is NOT a .tmp, survives cleanup)
    jq -r 'select(.ptr!=null) | "\(.host)\t\(.ptr[0])"' "$WORKDIR/ptr_sweep.json" 2>/dev/null \
        | sed 's/\.$//' | sort -u -k1,1 > "$WORKDIR/ptr_sweep.tsv"
    jq -r 'select(.ptr!=null) | .ptr[]' "$WORKDIR/ptr_sweep.json" 2>/dev/null \
        | tr '[:upper:]' '[:lower:]' | sed 's/\.$//' | sort -u > "$WORKDIR/ptr_names.tmp"
    rm -f "$WORKDIR/ptr_sweep.json"

    # keep only names inside our target scope, valid FQDNs
    local dom
    for dom in "${DOMAINS[@]}"; do
        grep -E "(^|\.)${dom//./\\.}$" "$WORKDIR/ptr_names.tmp"
    done | grep -E '^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$' \
         | sort -u > "$WORKDIR/ptr_scope.tmp"

    comm -23 "$WORKDIR/ptr_scope.tmp" <(sort -u "$WORKDIR/subs.txt") > "$WORKDIR/ptr_new.tmp"
    local nscope nnew; nscope=$(count "$WORKDIR/ptr_scope.tmp"); nnew=$(count "$WORKDIR/ptr_new.tmp")
    ok "PTR sweep: $nscope in-scope hostnames ($nnew new, not seen by passive sources)"
    [ "$nnew" -eq 0 ] && { rm -f "$WORKDIR"/ptr_*.tmp "$WORKDIR/cidrs.tmp"; return 0; }

    # fold new names into the master list and resolve them, merging results
    cat "$WORKDIR/ptr_new.tmp" >> "$WORKDIR/subs.txt"
    sort -u "$WORKDIR/subs.txt" -o "$WORKDIR/subs.txt"

    dnsx -l "$WORKDIR/ptr_new.tmp" -r "$WORKDIR/resolvers.txt" \
         -t "$DNS_THREADS" -retry "$DNS_RETRY" -timeout "$DNS_TIMEOUT" \
         -a -json -silent -nc 2>/dev/null \
        | jq -r 'select(.a!=null) | .host as $h | .a[0] | "\($h)\t\(.)"' 2>/dev/null \
        >> "$WORKDIR/resolved.tsv"
    sort -u "$WORKDIR/resolved.tsv" -o "$WORKDIR/resolved.tsv"
    cut -f2 "$WORKDIR/resolved.tsv" | sort -u > "$WORKDIR/ips.txt"

    ok "After expansion: $(count "$WORKDIR/resolved.tsv") resolved subdomains → $(count "$WORKDIR/ips.txt") unique IPs"
    rm -f "$WORKDIR"/ptr_*.tmp "$WORKDIR/cidrs.tmp"
}

###############################################################################
# 3b2. TLS certificate SAN expansion — read the Subject Alternative Names off
#     each live host's OWN certificate directly (a live TLS handshake, not a
#     CT log query). crt.sh is a historical, frequently-overloaded log; tlsx
#     reads current certs straight from the server, so it keeps working
#     exactly when crt.sh doesn't, and often reveals names crt.sh's log never
#     indexed. Confirmed via direct testing: on facebook.com it recovered
#     related domains missed entirely elsewhere (*.facebook.net, *.fbcdn.net
#     edge names, messenger.com). Optional — skipped cleanly if tlsx isn't
#     installed, same pattern as $HAVE_FINDOMAIN.
###############################################################################
tls_san_expand(){
    command -v tlsx &>/dev/null || { info "tlsx not installed — skipping TLS SAN expansion"; return 0; }
    local n; n=$(count "$WORKDIR/resolved.tsv")
    [ "$n" -eq 0 ] && return 0
    step "TLS certificate SAN expansion — reading live certs directly (no wordlist)"
    cut -f1 "$WORKDIR/resolved.tsv" > "$WORKDIR/_tls_hosts.tmp"
    timeout -k 10 240 tlsx -l "$WORKDIR/_tls_hosts.tmp" -san -silent -json \
         -c 500 -timeout 4 -retry 1 2>/dev/null > "$WORKDIR/tls_san.json"
    rm -f "$WORKDIR/_tls_hosts.tmp"

    jq -r '.subject_an[]?' "$WORKDIR/tls_san.json" 2>/dev/null \
        | sed 's/^\*\.//' | tr '[:upper:]' '[:lower:]' | sort -u > "$WORKDIR/tls_names.tmp"
    rm -f "$WORKDIR/tls_san.json"

    local dom
    for dom in "${DOMAINS[@]}"; do
        grep -E "(^|\.)${dom//./\\.}$" "$WORKDIR/tls_names.tmp"
    done | grep -E '^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$' \
         | sort -u > "$WORKDIR/tls_scope.tmp"
    rm -f "$WORKDIR/tls_names.tmp"

    comm -23 "$WORKDIR/tls_scope.tmp" <(sort -u "$WORKDIR/subs.txt") > "$WORKDIR/tls_new.tmp"
    local nscope nnew; nscope=$(count "$WORKDIR/tls_scope.tmp"); nnew=$(count "$WORKDIR/tls_new.tmp")
    ok "TLS SAN scan: $nscope in-scope hostname(s) ($nnew new, not seen by other sources)"
    rm -f "$WORKDIR/tls_scope.tmp"
    [ "$nnew" -eq 0 ] && { rm -f "$WORKDIR/tls_new.tmp"; return 0; }

    cat "$WORKDIR/tls_new.tmp" >> "$WORKDIR/subs.txt"
    sort -u "$WORKDIR/subs.txt" -o "$WORKDIR/subs.txt"

    dnsx -l "$WORKDIR/tls_new.tmp" -r "$WORKDIR/resolvers.txt" \
         -t "$DNS_THREADS" -retry "$DNS_RETRY" -timeout "$DNS_TIMEOUT" \
         -a -json -silent -nc 2>/dev/null \
        | jq -r 'select(.a!=null) | .host as $h | .a[0] | "\($h)\t\(.)"' 2>/dev/null \
        >> "$WORKDIR/resolved.tsv"
    sort -u "$WORKDIR/resolved.tsv" -o "$WORKDIR/resolved.tsv"
    cut -f2 "$WORKDIR/resolved.tsv" | sort -u > "$WORKDIR/ips.txt"
    rm -f "$WORKDIR/tls_new.tmp"

    ok "After TLS SAN expansion: $(count "$WORKDIR/resolved.tsv") resolved subdomains → $(count "$WORKDIR/ips.txt") unique IPs"
}

###############################################################################
# 3c. Wildcard-DNS filtering — a zone with a wildcard A record (e.g. an org's
#     internal "*.intern.example.com") makes ANY string under it "resolve",
#     turning noise (mutated candidates from a source, a PTR sweep oddity,
#     typos) into fake-looking confirmed subdomains. Standard practice (what
#     subfinder/dnsx/amass all do): find such zones by querying one random,
#     definitely-nonexistent label under each; if it resolves, every OTHER
#     name under that zone sharing that same IP is indistinguishable noise
#     and gets dropped. Zones are discovered from our OWN resolved data, not
#     a wordlist — this only ever narrows results, never guesses new names.
###############################################################################
filter_wildcards(){
    step "Wildcard-DNS filtering — dropping zones where any name resolves"
    # Candidate zones = every ancestor of a resolved name, from one label
    # dropped down to the matching target domain itself — a wildcard can sit
    # at ANY depth (e.g. "intern.instagram.com", 3 levels under a 6-label
    # host), not just one level up. Only test zones with >=3 resolved
    # children (cheap to query, not worth it for a 1-2 off name) — cap the
    # list so a huge run can't turn this into thousands of extra queries.
    cut -f1 "$WORKDIR/resolved.tsv" | awk -v domlist="$(printf '%s\n' "${DOMAINS[@]}")" '
        BEGIN{ nd=split(domlist,D,"\n") }
        { host=$0; n=split(host,lab,".")
          apexn=0
          for(d=1;d<=nd;d++){ dom=D[d]; if(dom=="") continue
              nda=split(dom,dl,"."); suf=""
              for(i=n-nda+1;i<=n;i++) suf=(suf==""?lab[i]:suf"."lab[i])
              if (suf==dom){ apexn=nda; break }
          }
          if (apexn==0) next
          for (start=2; start<=n-apexn+1; start++){
              suf=""
              for(i=start;i<=n;i++) suf=(suf==""?lab[i]:suf"."lab[i])
              print suf
          }
        }' | sort | uniq -c | awk '$1>=3{print $2}' | sort -u | head -n 500 > "$WORKDIR/_wc_cand.tmp"
    local ncand; ncand=$(count "$WORKDIR/_wc_cand.tmp")
    [ "$ncand" -eq 0 ] && { ok "No candidate zones to test"; rm -f "$WORKDIR/_wc_cand.tmp"; return 0; }
    info "Testing $ncand zone(s) for wildcard A records..."

    # Fire several random-label canaries per zone via plain `dig` against a
    # small set of major, fast resolvers — a wildcard behind anycast/GSLB can
    # answer with a different IP per resolver, so cycling through a handful
    # of providers catches far more variants than one fixed resolver would.
    # (Deliberately plain dig, not dnsx: dnsx carries its own built-in
    # wildcard-detection heuristics that, in testing, interacted badly with
    # feeding it synthetic wildcard-probe names — multi-minute stalls on
    # batches as small as 3 queries. dig has none of that and is instant.)
    local resolvers=(8.8.8.8 1.1.1.1 9.9.9.9 208.67.222.222 94.140.14.14 77.88.8.8)
    : > "$WORKDIR/_wc_jobs.tsv"
    local i=0 zone k r
    while read -r zone; do
        [ -z "$zone" ] && continue
        for k in 0 1 2; do
            r="${resolvers[$(( (i + k) % ${#resolvers[@]} ))]}"
            printf '%s\t%s\n' "$zone" "$r" >> "$WORKDIR/_wc_jobs.tsv"
        done
        i=$((i + 1))
    done < "$WORKDIR/_wc_cand.tmp"

    < "$WORKDIR/_wc_jobs.tsv" xargs -P 60 -L1 bash -c '
        zone="$1"; r="$2"
        rand="zzwc$(tr -dc a-z0-9 </dev/urandom | head -c14)"
        ip=$(dig +short +time=2 +tries=1 "${rand}.${zone}" A "@${r}" 2>/dev/null \
             | grep -E "^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$" | head -1)
        [ -n "$ip" ] && printf "%s\t%s\n" "$zone" "$ip"
    ' _ 2>/dev/null | sort -u > "$WORKDIR/_wc_zones.tsv"
    rm -f "$WORKDIR/_wc_jobs.tsv"

    local nwc_ips; nwc_ips=$(count "$WORKDIR/_wc_zones.tsv")
    if [ "$nwc_ips" -eq 0 ]; then
        ok "No wildcard zones detected"
        rm -f "$WORKDIR/_wc_cand.tmp" "$WORKDIR/_wc_zones.tsv" 
        return 0
    fi
    local nwc; nwc=$(cut -f1 "$WORKDIR/_wc_zones.tsv" | sort -u | wc -l | tr -d ' ')

    # Final pass: for every resolved host, walk its ancestor zones (same
    # suffixes considered as candidates above) and drop it if ANY of them is
    # a confirmed wildcard zone. NOT IP-matched: in testing, the SAME
    # wildcarded zone answered canary queries with several different IPs
    # (anycast/GSLB load-balancing) — 57.144.120.146, 31.13.72.18, 157.240.9.7,
    # 157.240.234.20 were all genuine wildcard answers for one zone. Once ANY
    # name under a zone is confirmed to "resolve to something," no answer
    # from that zone is distinguishable noise vs. a real record, so the whole
    # zone's results are dropped — standard practice, same as subfinder/amass.
    cut -f1 "$WORKDIR/_wc_zones.tsv" | sort -u > "$WORKDIR/_wc_zoneset.tmp"
    awk -F'\t' -v wcfile="$WORKDIR/_wc_zoneset.tmp" -v domlist="$(printf '%s\n' "${DOMAINS[@]}")" '
        BEGIN{ nd=split(domlist,D,"\n")
               while((getline line < wcfile) > 0){ wc[line]=1 } }
        { host=$1; n=split(host,lab,".")
          apexn=0
          for(d=1;d<=nd;d++){ dom=D[d]; if(dom=="") continue
              nda=split(dom,dl,"."); suf=""
              for(i=n-nda+1;i<=n;i++) suf=(suf==""?lab[i]:suf"."lab[i])
              if (suf==dom){ apexn=nda; break }
          }
          hit=0
          if (apexn>0){
              for (start=2; start<=n-apexn+1 && !hit; start++){
                  suf=""
                  for(i=start;i<=n;i++) suf=(suf==""?lab[i]:suf"."lab[i])
                  if (suf in wc) hit=1
              }
          }
          if (hit) { dropped++; next }
          print > "'"$WORKDIR"'/resolved.tsv.clean"
        }
        END{ print dropped+0 > "'"$WORKDIR"'/_wc_dropped.tmp" }
    ' "$WORKDIR/resolved.tsv"
    rm -f "$WORKDIR/_wc_zoneset.tmp"

    local ndropped; ndropped=$(cat "$WORKDIR/_wc_dropped.tmp" 2>/dev/null || echo 0)
    mv "$WORKDIR/resolved.tsv.clean" "$WORKDIR/resolved.tsv" 2>/dev/null
    sort -u "$WORKDIR/resolved.tsv" -o "$WORKDIR/resolved.tsv"
    cut -f2 "$WORKDIR/resolved.tsv" | sort -u > "$WORKDIR/ips.txt"
    ok "$nwc wildcard zone(s) found — dropped $ndropped wildcard-noise hostname(s)"
    rm -f "$WORKDIR/_wc_cand.tmp" "$WORKDIR/_wc_zones.tsv" "$WORKDIR/_wc_dropped.tmp" 
}

###############################################################################
# 4. Enrich unique IPs — Team Cymru bulk IP→ASN (ONE query, NO rate limit)
#    Returns ASN, country and org (AS name) for every routable IP at once.
#    This replaces ip-api, whose 15-req/min free limit left whole blocks of
#    real IPs with "-" (org/isp/country/asn).
###############################################################################
enrich_ips(){
    local n; n=$(count "$WORKDIR/ips.txt")
    step "Enriching $n unique IPs (Team Cymru bulk — ASN/org/country, no rate limit)"
    : > "$WORKDIR/ipinfo.tsv"     # ip<TAB>org<TAB>isp<TAB>country<TAB>asn

    # Bulk query: begin / verbose / <ips> / end  →  whois.cymru.com:43
    { printf 'begin\nverbose\n'; cat "$WORKDIR/ips.txt"; printf 'end\n'; } \
        | timeout -k 10 120 "$NC_BIN" whois.cymru.com 43 2>/dev/null > "$WORKDIR/cymru.raw"

    # Output rows look like:
    #   32934 | 66.220.144.141 | 66.220.144.0/21 | US | arin | 2009-.. | FACEBOOK - Facebook, Inc., US
    awk -F'|' '
    function trim(s){ gsub(/^[ \t]+|[ \t]+$/,"",s); return s }
    /Bulk mode|Error:|^[[:space:]]*$/ { next }
    NF>=7 {
        asn=trim($1); ip=trim($2); cc=trim($4); asname=trim($7)
        if (ip=="" || ip=="IP") next
        org=asname
        p=index(asname," - ")
        if (p>0) org=substr(asname,p+3)      # drop the "HANDLE - " prefix
        sub(/, *[A-Z][A-Z]$/,"",org)         # drop the trailing ", US" country code
        if (asn=="NA" || asn=="") { org="Private/Reserved"; cc=(cc==""?"ZZ":cc); asn="private" }
        else { asn="AS" asn }
        if (org=="") org="Unknown"
        if (cc=="")  cc="ZZ"
        print ip "\t" org "\t" org "\t" cc "\t" asn      # isp = org (same AS)
    }' "$WORKDIR/cymru.raw" | sort -u -k1,1 > "$WORKDIR/ipinfo.tsv"

    local got; got=$(count "$WORKDIR/ipinfo.tsv")
    ok "Enriched $got/$n IPs"
    if [ "$got" -lt "$n" ]; then
        warn "$((n-got)) IP(s) not returned by Cymru — retrying those with ip-api"
        enrich_ipapi_fallback
    fi
    rm -f "$WORKDIR/cymru.raw"
}

# Fallback only for the handful Cymru didn't answer (keeps us off ip-api's limit)
enrich_ipapi_fallback(){
    cut -f1 "$WORKDIR/ipinfo.tsv" | sort -u > "$WORKDIR/_have.tmp"
    comm -23 "$WORKDIR/ips.txt" "$WORKDIR/_have.tmp" > "$WORKDIR/_miss.tmp"
    local miss; miss=$(count "$WORKDIR/_miss.tmp")
    [ "$miss" -eq 0 ] && { rm -f "$WORKDIR/_have.tmp" "$WORKDIR/_miss.tmp"; return; }
    split -l 100 "$WORKDIR/_miss.tmp" "$WORKDIR/ipchunk_"
    local batch
    for batch in "$WORKDIR"/ipchunk_*; do
        [ -f "$batch" ] || continue
        local payload resp
        payload=$(jq -R -s -c 'split("\n")|map(select(length>0))' < "$batch")
        resp=$(curl -s -m 20 -X POST \
            "http://ip-api.com/batch?fields=status,query,org,isp,as,country" \
            -H "Content-Type: application/json" -d "$payload" 2>/dev/null)
        [ -n "$resp" ] && echo "$resp" | jq -r '.[]|select(.status=="success")
            | [.query,(.org//"Unknown"),(.isp//"Unknown"),(.country//"ZZ"),
               ((.as|split(" ")[0])//"-")]|@tsv' 2>/dev/null >> "$WORKDIR/ipinfo.tsv"
        sleep 1.4
    done
    # Any still missing → label clearly so the final table never shows a bare "-"
    cut -f1 "$WORKDIR/ipinfo.tsv" | sort -u > "$WORKDIR/_have.tmp"
    comm -23 "$WORKDIR/ips.txt" "$WORKDIR/_have.tmp" \
        | awk '{print $1"\tUnknown\tUnknown\tZZ\tunknown"}' >> "$WORKDIR/ipinfo.tsv"
    rm -f "$WORKDIR"/ipchunk_* "$WORKDIR/_have.tmp" "$WORKDIR/_miss.tmp"
}

###############################################################################
# 5. Port scan unique IPs (naabu)
###############################################################################
scan_ports(){
    step "Scanning ports [$PORTS_TO_SCAN] on $(count "$WORKDIR/ips.txt") IPs (naabu)"
    naabu -l "$WORKDIR/ips.txt" -p "$PORTS_TO_SCAN" -rate "$NAABU_RATE" \
          -json -silent -nc 2>/dev/null > "$WORKDIR/naabu.json"
    # ip<TAB>comma,separated,ports  (naabu can emit a port twice — dedupe them)
    jq -r '"\(.ip)\t\(.port)"' "$WORKDIR/naabu.json" 2>/dev/null \
        | sort -t$'\t' -k1,1 -k2,2n -u \
        | awk -F'\t' '{p[$1]=(p[$1]?p[$1]","$2:$2)} END{for(i in p)print i"\t"p[i]}' \
        > "$WORKDIR/ports.tsv"
    ok "$(count "$WORKDIR/ports.tsv") IPs have open ports"
}

###############################################################################
# 6. PTR (reverse DNS) + ping — once per unique IP
###############################################################################
ptr_and_ping(){
    step "Reverse DNS + ping ($(count "$WORKDIR/ips.txt") IPs)"
    # Reuse PTR records already gathered by the /24 sweep (reverse_dns_expand);
    # only query reverse DNS for IPs the sweep didn't cover. This avoids redoing
    # PTR on thousands of IPs. PTR work and ping run concurrently.
    : > "$WORKDIR/ptr.tsv"
    local miss="$WORKDIR/_missptr.tmp"; cp "$WORKDIR/ips.txt" "$miss"
    if [ -s "$WORKDIR/ptr_sweep.tsv" ]; then
        # Reuse the sweep's PTR records for IPs in our final set.
        awk -F'\t' 'NR==FNR{keep[$1]=1;next} ($1 in keep)' \
            "$WORKDIR/ips.txt" "$WORKDIR/ptr_sweep.tsv" > "$WORKDIR/ptr.tsv"
        # "miss" = only IPs whose /24 was NOT swept (truly need a fresh query).
        # IPs in a swept /24 are covered even if they have no PTR record.
        if [ -s "$WORKDIR/swept_nets.txt" ]; then
            awk -F. 'NR==FNR{sw[$0]=1;next}{p=$1"."$2"."$3; if(!(p in sw)) print}' \
                "$WORKDIR/swept_nets.txt" "$WORKDIR/ips.txt" > "$miss"
        else
            comm -23 <(sort -u "$WORKDIR/ips.txt") <(cut -f1 "$WORKDIR/ptr.tsv" | sort -u) > "$miss"
        fi
    fi
    local nmiss; nmiss=$(count "$miss")
    (
        if [ "$nmiss" -gt 0 ]; then
            dnsx -l "$miss" -r "$WORKDIR/resolvers.txt" -t "$DNS_THREADS" \
                 -ptr -json -silent -nc 2>/dev/null \
                | jq -r 'select(.ptr!=null) | "\(.host)\t\(.ptr[0])"' 2>/dev/null \
                | sed 's/\.$//' >> "$WORKDIR/ptr.tsv"
        fi
    ) &
    local ptr_pid=$!

    # fping: one parallel sweep. With -c1 the summary line is:
    #   1.2.3.4 : xmt/rcv/%loss = 1/1/0%, min/avg/max = 12.3/12.3/12.3   (no " ms")
    # A host is up when rcv>0; report its avg RTT, else "down".
    fping -c1 -t500 -q -f "$WORKDIR/ips.txt" 2>&1 \
        | awk '/: xmt\/rcv/ {
              ip=$1; up=0; avg="";
              if (match($0,/= [0-9]+\/[0-9]+\/[0-9]+%/)) {
                  t=substr($0,RSTART+2,RLENGTH-3); split(t,x,"/");  # xmt/rcv/loss
                  if (x[2]+0 > 0) up=1;
              }
              if (up && match($0,/min\/avg\/max = [0-9.]+\/[0-9.]+\/[0-9.]+/)) {
                  m=substr($0,RSTART,RLENGTH); sub(/.*= /,"",m); split(m,y,"/");
                  printf "%s\t%s ms\n", ip, y[2];
              } else { printf "%s\tdown\n", ip }
          }' > "$WORKDIR/ping.tsv"
    wait "$ptr_pid"   # make sure the concurrent PTR lookup is done
    rm -f "$WORKDIR/_missptr.tmp"
    ok "$(count "$WORKDIR/ptr.tsv") IPs have a PTR record ($nmiss queried fresh); pinged $(count "$WORKDIR/ping.tsv") IPs"
}

###############################################################################
# 7. HTTP probe (httpx) — status, title, webserver, tech
###############################################################################
http_probe(){
    step "HTTP probing $(count "$WORKDIR/resolved.tsv") live subdomains (httpx)"
    cut -f1 "$WORKDIR/resolved.tsv" > "$WORKDIR/live_subs.txt"
    httpx -l "$WORKDIR/live_subs.txt" -json -silent -nc \
          -status-code -title -web-server -tech-detect \
          -threads "$HTTP_THREADS" -timeout "$HTTP_TIMEOUT" -retries 1 \
          2>/dev/null > "$WORKDIR/httpx.json"
    # sub<TAB>code<TAB>title<TAB>server<TAB>tech
    # Strip '|' from text fields — it is our final column delimiter and page
    # titles legitimately contain it (e.g. "Foo | Bar").
    jq -r '[.input, (.status_code|tostring),
            ((.title//"")|gsub("[\t\n|]";" ")),
            ((.webserver//"-")|gsub("[\t\n|]";" ")),
            ((.tech//[])|join(",")|gsub("[\t\n|]";" "))] | @tsv' \
        "$WORKDIR/httpx.json" 2>/dev/null | sort -u > "$WORKDIR/http.tsv"
    ok "$(count "$WORKDIR/http.tsv") subdomains answered HTTP(S)"
}

###############################################################################
# 8. Assemble — one fully-populated row per subdomain
###############################################################################
assemble(){
    step "Assembling final report"
    echo "maindomain|subdomain|ip|hostname|organization|isp|country|asn|ports|http_code|title|webserver|tech|ping" > "$FINAL"

    DOMLIST=$(printf '%s\n' "${DOMAINS[@]}")

    # Single awk pass: load every per-IP / per-sub lookup table, then emit
    # one fully-populated row per resolved subdomain (resolved.tsv read last).
    awk -F'\t' -v OFS='|' -v PH="$PLACEHOLDER" -v domlist="$DOMLIST" '
    function blank(x){ return (x==""||x=="null") ? PH : x }
    function main_domain(s,   n,i,d){
        n=split(domlist,D,"\n")
        for(i=1;i<=n;i++){ d=D[i]; gsub(/\./,"\\.",d);
            if(d!="" && s ~ ("(^|\\.)" d "$")) return D[i] }
        return PH
    }
    FILENAME==F_IPINFO { org[$1]=$2; isp[$1]=$3; ctry[$1]=$4; asn[$1]=$5; next }
    FILENAME==F_PORTS  { ports[$1]=$2; next }
    FILENAME==F_PTR    { ptr[$1]=$2; next }
    FILENAME==F_PING   { ping[$1]=$2; next }
    FILENAME==F_HTTP   { code[$1]=$2; title[$1]=$3; srv[$1]=$4; tech[$1]=$5; next }
    FILENAME==F_RES {
        sd=$1; ip=$2
        printf "%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n",
            main_domain(sd), sd, ip,
            blank(ptr[ip]),
            blank(org[ip]), blank(isp[ip]), blank(ctry[ip]), blank(asn[ip]),
            blank(ports[ip]),
            blank(code[sd]), blank(title[sd]), blank(srv[sd]), blank(tech[sd]),
            blank(ping[ip])
    }
    ' F_IPINFO="$WORKDIR/ipinfo.tsv" F_PORTS="$WORKDIR/ports.tsv" \
      F_PTR="$WORKDIR/ptr.tsv" F_PING="$WORKDIR/ping.tsv" F_HTTP="$WORKDIR/http.tsv" \
      F_RES="$WORKDIR/resolved.tsv" \
      "$WORKDIR/ipinfo.tsv" "$WORKDIR/ports.tsv" "$WORKDIR/ptr.tsv" \
      "$WORKDIR/ping.tsv" "$WORKDIR/http.tsv" "$WORKDIR/resolved.tsv" \
      >> "$FINAL"

    ok "Wrote $(( $(count "$FINAL") - 1 )) rows → $FINAL"
}

###############################################################################
# 9. Report: preview + where it is saved + how to copy from Windows
###############################################################################
report(){
    step "FINAL RESULTS (first 20 rows)"
    # Pure-awk column aligner (the 'column' command isn't always installed).
    head -21 "$FINAL" | awk -F'|' '
        { for(i=1;i<=NF;i++){ if(length($i)>w[i])w[i]=length($i); c[NR,i]=$i } nf[NR]=NF; rows=NR }
        END{ for(r=1;r<=rows;r++){ for(i=1;i<=nf[r];i++) printf "%-*s  ", w[i], c[r,i]; print "";
             if(r==1){ for(i=1;i<=nf[r];i++){ for(j=1;j<=w[i]+2;j++)printf "-"; } print "" } } }'
    echo
    local rows; rows=$(( $(count "$FINAL") - 1 ))
    ok "Total subdomains in report: ${BOLD}$rows${NC}"

    # Integrity check — warn on any empty/zero cell so we never ship a bad column.
    local bad
    bad=$(awk -F'|' 'NR>1{for(i=1;i<=NF;i++) if($i==""||$i=="0"||$i=="000"){print NR; break}}' "$FINAL" | wc -l)
    if [ "$bad" -eq 0 ]; then
        ok "Integrity check: no empty / zero cells in any column"
    else
        warn "Integrity check: $bad row(s) contain an empty/zero cell (shown as '-' is OK; literal empty is not)"
    fi

    echo
    step "Where your results are saved"
    printf "  ${BOLD}Inside Kali (WSL):${NC}\n"
    printf "    %s\n\n" "$FINAL"

    # Windows-visible path via \\wsl.localhost\<distro>\...  (printf %s so the
    # backslashes are printed literally — echo -e would eat \r \f \root etc.)
    local winpath winfile
    winpath=$(wslpath -w "$WORKDIR" 2>/dev/null)
    winfile=$(wslpath -w "$FINAL" 2>/dev/null)
    if [ -n "$winpath" ]; then
        printf "  ${BOLD}From Windows (paste into File Explorer's address bar):${NC}\n"
        printf "    %s\n\n" "$winpath"
        printf "  ${BOLD}Copy to your Windows Desktop (run in PowerShell on Windows):${NC}\n"
        printf '    copy "%s" "%%USERPROFILE%%\\Desktop"\n\n' "$winfile"
        printf "  ${BOLD}Or open the folder straight from Kali:${NC}\n"
        printf '    explorer.exe "%s"\n' "$winpath"
    else
        warn "Could not derive the Windows path (wslpath)."
        printf '    Your distro root is reachable from Windows at: \\\\wsl.localhost\\kali-linux\\root\n'
    fi

    if [ -n "$WIN_SAVED" ]; then
        printf "\n  ${BOLD}${GREEN}✓ Auto-saved a copy to your Windows Documents:${NC}\n"
        printf "    %s\n" "$(wslpath -w "$WIN_SAVED" 2>/dev/null || echo "$WIN_SAVED")"
        printf "    (open Documents in File Explorer to find it)\n"
    fi
}

###############################################################################
# Telegram (opt-in)
###############################################################################
send_telegram(){
    [ -z "$TELEGRAM_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ] && {
        info "Telegram not configured (set TELEGRAM_TOKEN and TELEGRAM_CHAT_ID to enable)"; return; }
    local api="https://api.telegram.org/bot${TELEGRAM_TOKEN}"
    local rows; rows=$(( $(count "$FINAL") - 1 ))
    curl -sf -X POST "$api/sendMessage" \
        --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
        --data-urlencode "text=✅ Recon done — ${rows} subdomains for: ${DOMAINS[*]}" >/dev/null \
        && ok "Telegram message sent" || warn "Telegram message failed"
    curl -sf -X POST "$api/sendDocument" \
        -F "chat_id=${TELEGRAM_CHAT_ID}" -F "document=@${FINAL}" \
        -F "caption=Subdomains — ${rows} entries" >/dev/null \
        && ok "Telegram file sent" || warn "Telegram file send failed"
}

###############################################################################
# Helpers
###############################################################################
count(){ [ -f "$1" ] && wc -l < "$1" | tr -d ' ' || echo 0; }

###############################################################################
# Auto-copy the result into the Windows user's Documents (WSL only)
# Works on any WSL PC — detects the folder dynamically (incl. OneDrive redirect).
###############################################################################
is_wsl(){ grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; }

_win_ps(){  command -v powershell.exe 2>/dev/null && return
            local p="/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
            [ -x "$p" ] && echo "$p"; }
_win_cmd(){ command -v cmd.exe 2>/dev/null && return
            local p="/mnt/c/Windows/System32/cmd.exe"; [ -x "$p" ] && echo "$p"; }

detect_win_docs(){
    local bin raw base u b
    # 1) PowerShell MyDocuments — honours OneDrive / redirected Documents
    bin=$(_win_ps) && [ -n "$bin" ] && {
        raw=$(cd /mnt/c 2>/dev/null && "$bin" -NoProfile -Command \
              '[Environment]::GetFolderPath("MyDocuments")' 2>/dev/null | tr -d '\r')
        [ -n "$raw" ] && { wslpath -u "$raw" 2>/dev/null; return 0; }
    }
    # 2) cmd USERPROFILE\Documents
    bin=$(_win_cmd) && [ -n "$bin" ] && {
        raw=$(cd /mnt/c 2>/dev/null && "$bin" /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r')
        [ -n "$raw" ] && { echo "$(wslpath -u "$raw")/Documents"; return 0; }
    }
    # 3) scan mounted Windows drives for a real user's Documents folder
    for base in /mnt/c /mnt/d /mnt/e; do
        for u in "$base"/Users/*/; do
            b=$(basename "$u")
            case "$b" in Public|Default|"Default User"|"All Users"|desktop.ini|WsiAccount) continue;; esac
            [ -d "${u}OneDrive/Documents" ] && { echo "${u}OneDrive/Documents"; return 0; }
            [ -d "${u}Documents" ]          && { echo "${u}Documents";          return 0; }
        done
    done
    return 1
}

WIN_SAVED=""
save_to_windows(){
    is_wsl || return 0
    local docs; docs=$(detect_win_docs) \
        || { warn "Windows Documents folder not found — skipping Windows copy"; return 0; }
    mkdir -p "$docs" 2>/dev/null
    local name="${DOMAINS[0]}_subdomains_$(date +%Y%m%d_%H%M%S).txt"
    if cp "$FINAL" "$docs/$name" 2>/dev/null; then
        WIN_SAVED="$docs/$name"
    else
        warn "Could not write to Windows Documents ($docs)"
    fi
}

###############################################################################
# Main
###############################################################################
main(){
    echo -e "${CYAN}${BOLD}Subdomain Recon${NC}  —  $(date)"
    check_tools
    fetch_cc_index

    DOMAINS=("$@")
    if [ "${#DOMAINS[@]}" -eq 0 ]; then
        echo -ne "${YELLOW}[?] Enter target domain(s), space-separated: ${NC}"
        read -r -a DOMAINS
    fi
    [ "${#DOMAINS[@]}" -eq 0 ] && { err "No domains given"; exit 1; }

    setup_workspace "${DOMAINS[0]}"
    : > "$WORKDIR/raw_subs.txt"
    mkdir -p "$WORKDIR/enum"

    # Enumerate domains in batches of MAX_PARALLEL_DOMAINS (each domain already
    # runs its ~9 sources concurrently). The real fix for rate-limit zeroing
    # was removing/replacing the structurally fragile sources (hackertarget's
    # tiny daily quota, certspotter's anon quota, OTX's auth-walled
    # passive_dns) — not batch size: once those were gone, 15 domains fully
    # unbatched (one round) showed no degradation across any remaining
    # source, just ~2x faster than batching them. This cap now exists purely
    # as a safety valve against a pathologically large domain list spawning
    # thousands of concurrent local processes, not as a rate-limit mitigation.
    local d epids=() dlog i total=${#DOMAINS[@]}
    [ "$total" -gt 1 ] && info "Enumerating $total domain(s), ${MAX_PARALLEL_DOMAINS} at a time..."
    i=0
    while [ "$i" -lt "$total" ]; do
        epids=()
        local batch=("${DOMAINS[@]:$i:$MAX_PARALLEL_DOMAINS}")
        for d in "${batch[@]}"; do
            dlog="$WORKDIR/enum/_log_$(printf '%s' "$d" | tr -c 'a-zA-Z0-9' '_').txt"
            run_enumeration "$d" > "$dlog" 2>&1 &
            epids+=("$!")
        done
        wait "${epids[@]}"
        i=$((i + MAX_PARALLEL_DOMAINS))
    done
    for d in "${DOMAINS[@]}"; do
        cat "$WORKDIR/enum/_log_$(printf '%s' "$d" | tr -c 'a-zA-Z0-9' '_').txt" 2>/dev/null
    done
    cat "$WORKDIR"/enum/*/*.txt 2>/dev/null >> "$WORKDIR/raw_subs.txt"

    clean_subs
    resolve
    asn_netblocks
    reverse_dns_expand
    tls_san_expand
    filter_wildcards

    # Enrichment is a single short network read (Team Cymru bulk, ~5s). Run it
    # FIRST, on its own, so the nc stream isn't truncated by competing traffic.
    enrich_ips

    # The remaining three stages are independent and network/CPU-bound, so run
    # them concurrently (each logs to its own file, printed in order afterwards).
    step "Ports + reverse-DNS/ping + HTTP  (running in parallel)"
    scan_ports   > "$WORKDIR/log_ports.txt"  2>&1 &  local pp=$!
    ptr_and_ping > "$WORKDIR/log_ptr.txt"    2>&1 &  local pr=$!
    http_probe   > "$WORKDIR/log_http.txt"   2>&1 &  local ph=$!
    wait "$pp" "$pr" "$ph"
    cat "$WORKDIR"/log_ports.txt "$WORKDIR"/log_ptr.txt \
        "$WORKDIR"/log_http.txt 2>/dev/null
    rm -f "$WORKDIR"/log_*.txt

    assemble
    save_to_windows
    report
    send_telegram

    echo
    ok "${BOLD}Done.${NC} Full results: $FINAL"
}

main "$@"
